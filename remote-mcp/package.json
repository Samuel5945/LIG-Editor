{
  "name": "lig-remote-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "立格编辑器远程 MCP 网关：对外说 MCP（StreamableHTTP），对内用 WebSocket 接编辑器设备端",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
